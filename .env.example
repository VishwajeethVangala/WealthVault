# WealthVault Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual Azure credentials

# Deployment Environment tier: development | staging | production
ENVIRONMENT=development

# Azure Storage Account Connection String (Table and Blob operations)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<your_storage_account>;AccountKey=<your_account_key>;EndpointSuffix=core.windows.net"

# Google Identity (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID="<your-google-client-id>.apps.googleusercontent.com"

# Internal Session JWT Secret Key (Generate a random 64-character secret)
JWT_SECRET="wealthvault-dev-secret-key-replace-with-strong-key-in-prod"

# Fernet key encrypting stored broker credentials. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# INDmoney MCP OAuth client (register one with INDmoney; never commit real values)
INDMONEY_CLIENT_ID=
INDMONEY_CLIENT_SECRET=
